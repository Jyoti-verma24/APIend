# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Find the first two in Supabase -> Project Settings -> API.

SUPABASE_URL=https://your-project.supabase.co

# The service_role key, NOT the anon key. It bypasses Row Level Security, so it
# must only ever live here on the server - never inside index.html.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password the tailor types once to use the dashboard. Leave it unset and the
# dashboard is open to anyone with the URL, which is fine for a local demo but
# not for anything you share.
TAILOR_PASSCODE=choose-any-password
